rules_version = '2';

// Darazinda Connect — Firestore Security Rules
//
// Principles:
//  - Measurements, reports, and surveys are appended by any signed-in
//    OR anonymous (guest) client, but a document's owner fields
//    (userId / anonymousDeviceId) must match the identity that created
//    it and can never be changed after creation.
//  - Public read access is allowed on aggregated/public collections
//    (measurements, schools, health_facilities) since the whole point
//    of the app is a shared community map — but no collection exposes
//    email, phone, or other private profile fields; those live only in
//    /users/{uid} and are owner-readable only.
//  - Only users with a custom claim `admin: true` (set via Cloud
//    Functions / Firebase Admin SDK, never client-side) may update
//    report status, or read/write anything under /admin.
//  - Mutation of another user's document is always denied.

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() && request.auth.token.admin == true;
}

function isOwner(resourceData) {
  return isSignedIn() && resourceData.userId == request.auth.uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Private per-user profile data (email, display name, etc.).
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Public, community-sourced signal measurements.
    match /measurements/{measurementId} {
      allow read: if true;
      allow create: if
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.userId == null &&
          request.resource.data.anonymousDeviceId is string);
      // Measurements are immutable evidence once written.
      allow update, delete: if isAdmin();
    }

    // Citizen-submitted problem reports.
    match /reports/{reportId} {
      allow read: if true;
      allow create: if
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.userId == null &&
          request.resource.data.anonymousDeviceId is string);
      // Only the original submitter may edit description/photo (not
      // status); only admins may change status.
      allow update: if isAdmin() ||
        (isOwner(resource.data) &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isSignedIn() || true; // open contribution, rate-limited via App Check
      allow update, delete: if isAdmin();
    }

    match /health_facilities/{facilityId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update, delete: if isAdmin();
    }

    // Aggregated/derived areas (e.g. precomputed probable dead zones),
    // written only by trusted Cloud Functions using the Admin SDK.
    match /areas/{areaId} {
      allow read: if true;
      allow write: if false;
    }

    match /operators/{operatorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Internal admin-only collections (moderation queues, exports).
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
